//2개 모터 동시 회전 가능. 회전 중 추가 입력 무시
const int MOTOR1_EN  = 2;
const int MOTOR1_STP = 3;
const int MOTOR1_DIR = 4;

const int MOTOR2_EN  = 5;
const int MOTOR2_STP = 6;
const int MOTOR2_DIR = 7;

// 1.8도 스텝모터, MStep = 16 기준
const int PULSES_90 = 800;

// 펄스 HIGH/LOW 유지 시간 (us)
const unsigned long PULSE_US = 1500;

// 모터별 상태 변수
struct Motor {
  int stpPin;
  int dirPin;

  int pulseCount;
  bool running;
  bool pulseHigh;

  unsigned long lastPulseTime;
};

// 모터 1, 모터 2
Motor motor1 = {MOTOR1_STP, MOTOR1_DIR, 0, false, true, 0};
Motor motor2 = {MOTOR2_STP, MOTOR2_DIR, 0, false, true, 0};

void setup() {

  // 모터 1 초기 설정
  digitalWrite(MOTOR1_EN, HIGH);
  digitalWrite(MOTOR1_STP, HIGH);
  digitalWrite(MOTOR1_DIR, LOW);

  pinMode(MOTOR1_EN, OUTPUT);
  pinMode(MOTOR1_STP, OUTPUT);
  pinMode(MOTOR1_DIR, OUTPUT);

  // 모터 2 초기 설정
  digitalWrite(MOTOR2_EN, HIGH);
  digitalWrite(MOTOR2_STP, HIGH);
  digitalWrite(MOTOR2_DIR, LOW);

  pinMode(MOTOR2_EN, OUTPUT);
  pinMode(MOTOR2_STP, OUTPUT);
  pinMode(MOTOR2_DIR, OUTPUT);

  Serial.begin(9600);

  // EN = LOW : 모터 활성화
  digitalWrite(MOTOR1_EN, LOW);
  digitalWrite(MOTOR2_EN, LOW);

  Serial.println("Motors Ready");
  Serial.println("1: Motor 1 CW 90 degrees");
  Serial.println("2: Motor 1 CCW 90 degrees");
  Serial.println("3: Motor 2 CW 90 degrees");
  Serial.println("4: Motor 2 CCW 90 degrees");
}

// 모터 회전 시작
void startMotor(Motor &motor, bool clockwise) {

  // 이미 회전 중이면 새로운 명령 무시
  if (motor.running) {
    return;
  }

  digitalWrite(motor.dirPin, clockwise ? HIGH : LOW);

  motor.pulseCount = 0;
  motor.running = true;
  motor.pulseHigh = true;

  digitalWrite(motor.stpPin, HIGH);

  // 방향 설정 후 10ms 대기 시간을 비차단 방식으로 확보
  motor.lastPulseTime = micros() + 10000UL - PULSE_US;
}

// 모터 상태 업데이트 (Non-blocking)
void updateMotor(Motor &motor) {

  if (!motor.running) {
    return;
  }

  unsigned long now = micros();

  if ((long)(now - motor.lastPulseTime) < (long)PULSE_US) {
    return;
  }

  motor.lastPulseTime = now;

  if (motor.pulseHigh) {

    // LOW 출력
    digitalWrite(motor.stpPin, LOW);
    motor.pulseHigh = false;

  } else {

    // HIGH 출력
    digitalWrite(motor.stpPin, HIGH);
    motor.pulseHigh = true;

    motor.pulseCount++;

    // 800펄스 완료
    if (motor.pulseCount >= PULSES_90) {
      motor.running = false;
      Serial.println("Done");
    }
  }
}

void loop() {

  // 시리얼 명령 확인
  if (Serial.available() > 0) {

    char command = Serial.read();

    switch (command) {

      case '1':
        Serial.println("Motor 1 CW 90 degrees");
        startMotor(motor1, true);
        break;

      case '2':
        Serial.println("Motor 1 CCW 90 degrees");
        startMotor(motor1, false);
        break;

      case '3':
        Serial.println("Motor 2 CW 90 degrees");
        startMotor(motor2, true);
        break;

      case '4':
        Serial.println("Motor 2 CCW 90 degrees");
        startMotor(motor2, false);
        break;
    }
  }

  // 두 모터를 독립적으로 업데이트
  updateMotor(motor1);
  updateMotor(motor2);
}
